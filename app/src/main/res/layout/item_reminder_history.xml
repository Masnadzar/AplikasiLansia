<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/card_reminder_history"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="13dp"
    android:elevation="20dp"
    app:cardElevation="5dp"
    android:layout_marginTop="12dp"
    android:layout_marginHorizontal="18dp"
    android:layout_marginBottom="6dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="14dp">

        <ImageView
            android:id="@+id/img_history_ic"
            android:layout_width="55dp"
            android:layout_height="55dp"
            android:layout_marginEnd="12dp"
            android:alpha="0.7"
            tools:ignore="ContentDescription"/>

        <TextView
            android:id="@+id/tv_history_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nama Pengingat"
            android:textSize="18sp"
            android:fontFamily="@font/inter_semibold"
            android:textColor="@color/black"
            android:layout_toEndOf="@id/img_history_ic"
            android:layout_alignParentEnd="true"/>

        <TextView
            android:id="@+id/tv_history_time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Hari ini pukul 12.00"
            android:textSize="14sp"
            android:textColor="#616161"
            android:layout_below="@id/tv_history_title"
            android:layout_toEndOf="@id/img_history_ic"/>

        <TextView
            android:id="@+id/tv_history_desc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Deskripsi pengingat"
            android:textSize="15sp"
            android:layout_marginTop="4dp"
            android:layout_below="@id/tv_history_time"
            android:layout_toEndOf="@id/img_history_ic"/>

    </RelativeLayout>

</androidx.cardview.widget.CardView>