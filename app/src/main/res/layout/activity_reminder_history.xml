<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/layout_bottom_gray"
    android:orientation="vertical"
    tools:context=".ui.reminder.ReminderHistoryActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_back_reminder_history"
            style="@style/BlueRoundButtonNoOutline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/back"
            android:textSize="16sp"
            android:layout_marginStart="14dp"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="3dp"/>
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/reminder_history_title"
        android:textStyle="bold"
        android:textSize="26sp"
        android:textAlignment="center"
        android:textColor="@color/black"
        android:layout_marginVertical="12dp"/>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#E0E5E9"
        android:paddingTop="12dp">

        <TextView
            android:id="@+id/tv_no_history"
            android:layout_width="match_parent"
            android:layout_height="250dp"
            android:text="@string/reminder_history_empty"
            android:gravity="center"
            android:paddingHorizontal="63dp"
            android:textSize="22sp"
            android:fontFamily="@font/inter_medium"
            android:visibility="gone"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_reminder_history"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            tools:listitem="@layout/item_reminder_history"/>

    </RelativeLayout>

</LinearLayout>